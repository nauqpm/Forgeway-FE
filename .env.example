# Public Web Push build-time configuration. Replace angle-bracket placeholders
# through the deployment secret store; never put real credentials in this file.
NEXT_PUBLIC_WEB_PUSH_ENABLED=<true-or-false>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<public-vapid-key>

# Frontend runtime configuration supplied by the deployment host to the container.
# This public key must be the same public key used at build time above.
WEB_PUSH_VAPID_PUBLIC_KEY=<same-public-vapid-key>
BACKEND_API_URL=<backend-api-url>
